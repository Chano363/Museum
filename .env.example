# Museum 3D Exhibition System Environment Configuration
# 复制此文件为 .env 并填写配置

# ===========================================
# AI 生图配置（即梦 AI）
# ===========================================
# 注意：即梦账号需要自己注册，注册后会赠送 200 次生图次数
# 注册地址: https://console.volcengine.com/ark
# API Key 获取: https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey

AI_PROVIDER=jimeng
ARK_API_KEY=
JIMENG_MODEL=doubao-seedream-4-5-251128

# ===========================================
# 服务器配置
# ===========================================

# 后端服务端口
PORT=5000

# 前端开发服务器端口
VITE_PORT=3002

# 后端 API 地址
VITE_BACKEND_URL=http://localhost:5000

# CORS 允许的源（多个用逗号分隔，* 表示允许所有）
CORS_ORIGINS=*

# ===========================================
# Python 环境配置
# ===========================================

# Conda 环境名称
CONDA_ENV_NAME=dynamic

# Conda 环境路径前缀（Windows 默认）
CONDA_PREFIX=D:\Anaconda\envs

# Python 解释器路径（可选，优先级最高，一般选择conda对应的python.exe）
PYTHON_PATH=

# ===========================================
# 手势识别配置
# ===========================================

# 手势历史记录最大长度
VITE_MAX_HISTORY_LENGTH=30

# 手势稳定性阈值
VITE_STABILITY_THRESHOLD=0.5

# 静态手势最小历史记录数
VITE_MIN_HISTORY_LENGTH_STATIC=3

# 动态手势最小历史记录数
VITE_MIN_HISTORY_LENGTH_DYNAMIC=5

# 静态手势稳定性阈值
VITE_STABILITY_THRESHOLD_STATIC=0.5

# 动态手势稳定性阈值
VITE_STABILITY_THRESHOLD_DYNAMIC=0.45

# 后端连接超时时间（毫秒）
VITE_CONNECTION_TIMEOUT=3000

# 最大重试次数
VITE_MAX_RETRIES=1

# 最小请求间隔（毫秒）
VITE_MIN_REQUEST_INTERVAL=33

# 发送图像宽度
VITE_IMAGE_WIDTH=320

# 发送图像高度
VITE_IMAGE_HEIGHT=240

# JPEG 压缩质量
VITE_IMAGE_QUALITY=0.7

# ===========================================
# 模型控制配置
# ===========================================

# 缩放步长
VITE_ZOOM_STEP=0.2

# 最小相机距离
VITE_MIN_CAMERA_DISTANCE=0.1

# 最大相机距离
VITE_MAX_CAMERA_DISTANCE=1

# 旋转灵敏度
VITE_ROTATION_SENSITIVITY=0.5

# ===========================================
# 后端模型配置
# ===========================================

# 手部检测模型路径
DETECTION_MODEL_PATH=dynamic_gestures/models/YOLOv10n_hands.onnx

# 手势分类模型路径
CLASSIFICATION_MODEL_PATH=dynamic_gestures/models/crops_classifier.onnx

# MediaPipe 手部关键点模型路径
HAND_LANDMARKER_PATH=models/hand_landmarker.task

# 手势识别置信度阈值
CONFIDENCE_THRESHOLD=0.6

# 检测置信度阈值
DETECTION_CONFIDENCE_THRESHOLD=0.4

# ===========================================
# MediaPipe 配置
# ===========================================

# 最大检测手数
MP_NUM_HANDS=1

# 最小检测置信度
MP_MIN_DETECTION_CONFIDENCE=0.5

# 最小存在置信度
MP_MIN_PRESENCE_CONFIDENCE=0.5

# 最小追踪置信度
MP_MIN_TRACKING_CONFIDENCE=0.5
